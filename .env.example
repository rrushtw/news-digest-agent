# 複製此檔為 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，請勿將真實金鑰提交進版控。

# Google Gemini API Key（https://aistudio.google.com/app/apikey）
GEMINI_API_KEY=your-gemini-api-key

# （可選）指定 Gemini 模型；省略時程式預設為 gemini-3.5-flash
GEMINI_MODEL_NAME=gemini-3.5-flash

# Gmail 設定（寄件者）
GMAIL_USER=your-email@gmail.com
# Gmail 應用程式密碼（需開啟兩步驟驗證後產生）https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 收件者清單（逗號分隔，可多筆）
TARGET_EMAIL=grandpa@example.com, grandma@example.com, me@example.com
